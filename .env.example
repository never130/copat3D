# Copiar a .env.local y completar. Ver docs/03-arquitectura.md

# Postgres. En desarrollo con docker compose ya viene configurado.
# En producción: connection string de Neon.
DATABASE_URL=postgres://copat:copat@localhost:5432/copat3d

# Resend — envío de correo. https://resend.com/api-keys
# Sin esto el formulario de contacto no envía: muestra un aviso y deriva al
# correo institucional, pero no rompe la página.
RESEND_API_KEY=

# Remitente de los mails. Resend exige un dominio verificado (SPF/DKIM/DMARC,
# ver docs/05). Hasta que esté verificado copat3d.com.ar, dejar vacío: el
# código cae al remitente de prueba de Resend.
# Cuando esté listo: COPAT 3D <no-responder@copat3d.com.ar>
RESEND_FROM=

# Destinatario institucional de los formularios de contacto
CONTACT_TO=copat3d@aif.gob.ar

# URL pública del sitio (usada en metadata y Open Graph)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Enlace público al evento en Eventbrite (canal alternativo de inscripción)
NEXT_PUBLIC_EVENTBRITE_URL=
